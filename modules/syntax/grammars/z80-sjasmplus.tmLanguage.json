{
 "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
 "name": "Z80 Assembly (sjasmplus)",
 "patterns": [
  {
   "include": "#comments"
  },
  {
   "include": "#line-directive"
  },
  {
   "include": "#end-of-source"
  },
  {
   "include": "#directive"
  },
  {
   "include": "#label-definition"
  },
  {
   "include": "#includes"
  },
  {
   "include": "#keywords"
  },
  {
   "include": "#strings"
  },
  {
   "include": "#mnemonics"
  },
  {
   "include": "#numbers"
  },
  {
   "include": "#labels"
  }
 ],
 "repository": {
  "comments": {
   "patterns": [
    {
     "name": "comment.block.z80asm",
     "begin": "/\\*",
     "end": "\\*/"
    },
    {
     "name": "comment.line.z80asm",
     "begin": ";",
     "end": "\\n"
    },
    {
     "name": "comment.line.z80asm",
     "begin": "//",
     "end": "\\n"
    }
   ]
  },
  "keywords": {
   "patterns": [
    {
     "name": "keyword.control.repeat.z80asm",
     "match": "(?<=[\\s:])\\.(?:\\d+|\\([^)\\n]*\\))(?=\\s)"
    },
    {
     "name": "meta.embedded.block.lua",
     "begin": "(?i:(?<=[\\s:])(lua)\\b(?:\\s+(allpass|pass[123])\\b)?)",
     "beginCaptures": {
      "1": {
       "name": "keyword.control.z80asm"
      },
      "2": {
       "name": "support.type.flag.z80asm"
      }
     },
     "end": "(?i:(?<=[\\s:])(endlua)\\b)",
     "endCaptures": {
      "1": {
       "name": "keyword.control.z80asm"
      }
     },
     "contentName": "source.lua",
     "patterns": [
      {
       "include": "source.lua"
      }
     ]
    },
    {
     "begin": "(?i:(?<=[\\s:])(dg|defg)\\b)",
     "beginCaptures": {
      "1": {
       "name": "keyword.control.z80asm"
      }
     },
     "end": "(?=;|//|$)",
     "patterns": [
      {
       "include": "#strings"
      },
      {
       "name": "constant.numeric.integer.binary.z80asm",
       "match": "[^\\s;\\\"']+"
      }
     ]
    },
    {
     "begin": "(?i:(?<=[\\s:])(dh|defh|hex)\\b)",
     "beginCaptures": {
      "1": {
       "name": "keyword.control.z80asm"
      }
     },
     "end": "(?=;|//|$)",
     "patterns": [
      {
       "include": "#strings"
      },
      {
       "name": "constant.numeric.integer.hexadecimal.z80asm",
       "match": "[0-9A-Fa-f]+"
      }
     ]
    },
    {
     "name": "support.type.flag.z80asm",
     "match": "(?<=\\s)--[A-Za-z][\\w-]*(?:=[^\\s,;:]*)?"
    },
    {
     "match": "(?i:(?<=\\bcode)\\s+(page)\\b)",
     "captures": {
      "1": {
       "name": "keyword.control.z80asm"
      }
     }
    }
   ]
  },
  "strings": {
   "patterns": [
    {
     "match": "(?i:\\b((?:af|bc|de|hl)'))",
     "captures": {
      "1": {
       "name": "support.type.register.z80asm"
      }
     }
    },
    {
     "name": "string.quoted.single.z80asm",
     "begin": "'",
     "beginCaptures": {
      "0": {
       "name": "punctuation.definition.string.begin.z80asm"
      }
     },
     "end": "(')(?!')(?:[zZcC](?!\\w))?|([^\\n])$|$",
     "endCaptures": {
      "1": {
       "name": "punctuation.definition.string.end.z80asm"
      },
      "2": {
       "name": "invalid.illegal.newline.z80asm"
      }
     },
     "patterns": [
      {
       "name": "constant.character.escape.z80asm",
       "match": "''"
      }
     ]
    },
    {
     "name": "string.quoted.double.z80asm",
     "begin": "\"",
     "beginCaptures": {
      "0": {
       "name": "punctuation.definition.string.begin.z80asm"
      }
     },
     "end": "(\\\")(?:[zZcC](?!\\w))?|((?:[^\\\\\\n])$)|(?<!\\\\)$",
     "endCaptures": {
      "1": {
       "name": "punctuation.definition.string.end.z80asm"
      },
      "2": {
       "name": "invalid.illegal.newline.z80asm"
      }
     },
     "patterns": [
      {
       "include": "#string-character-escape"
      }
     ]
    }
   ]
  },
  "string-character-escape": {
   "patterns": [
    {
     "name": "constant.character.escape.z80asm",
     "match": "\\\\(x[0-9A-Fa-f]{2}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
   ]
  },
  "mnemonics": {
   "patterns": [
    {
     "name": "support.type.flag.z80asm",
     "match": "\\b(?i:(j[pr]|call|ret))(?:\\s+(?i:([cmpsz]|n[csz]|p[eo])))?\\b",
     "captures": {
      "1": {
       "name": "keyword.mnemonic.z80asm"
      },
      "2": {
       "name": "meta.preprocessor.flag.z80asm"
      }
     }
    },
    {
     "name": "support.type.flag.z80asm",
     "match": "\\b(?i:z80|r800|msx|gbz80|zxspectrum(?:48|128|256|512|1024|2048|4096|8192|next)|amstradcpc(?:464|6128|plus)|noslot64k|(?:no)?(?:expand|expif|expmacro|export|intlabel|globalsymbols))\\b"
    },
    {
     "name": "constant.numeric.operator.z80asm",
     "match": "\\b(?i:high|low|not|mod|sh[lr]|abs|sizeof|exist|norel|pair|u16)\\b",
     "comment": "sjasm numeric operators"
    },
    {
     "name": "keyword.mnemonic.z80asm",
     "match": "(?:^|(?<=[\\s:]))(?i:ad[cd]|and|bit|ccf|cp|cp[di]r?|cpl|daa|dec|[de]i|djnz|ex[adx]?|halt|i[mn]|inc|in[di]r?|ld|ld[di]r?|neg|nop|or|ot[di]r|out|out[di]|pop|push|res|ret[in]|rla?|rlca?|r[lr]d|rra?|rrca?|rst|sbc|scf|set|s[lr]a|s[lr]l|slia|sli|sl1|sub|x?or)(?=[\\s:;]|$)"
    },
    {
     "name": "keyword.mnemonic.z80asm",
     "match": "(?:^|(?<=[\\s:]))(?i:swap|ldir?x|ldws|lddr?x|ldpirx|outinb|swapnib|mul|mirror|nextreg|pixel(ad|dn)|setae|te?st|bs[lr]a|bsr[lf]|brlc)(?=[\\s:;]|$)"
    },
    {
     "name": "support.type.register.z80asm",
     "match": "\\b(?i:[abcdefhlir]|ix|iy|af'?|bc|de|hl|pc|sp|ix[hlu]|iy[hlu]|[lh]x|x[lh]|[lh]y|y[lh])\\b"
    },
    {
     "name": "constant.language.operator.z80asm",
     "match": "(?i:\\{(?:hex[248]?|bin(?:8|16|32)?|int|eval|r[bw])?\\})"
    },
    {
     "name": "constant.language.z80asm",
     "match": "\\b__(?:SJASMPLUS|VERSION|PASS|ERRORS|WARNINGS|INCLUDE_LEVEL|BASE_FILE|FILE|LINE|COUNTER|DATE|TIME)__\\b"
    }
   ]
  },
  "numbers": {
   "patterns": [
    {
     "name": "constant.language.pc.z80asm",
     "match": "\\${2,4}|\\$(?![0-9a-fA-F])"
    },
    {
     "name": "constant.numeric.integer.hexadecimal.z80asm",
     "match": "[$#][0-9a-fA-F](?:['_]?[0-9a-fA-F])*\\b"
    },
    {
     "name": "constant.numeric.integer.hexadecimal.z80asm",
     "match": "\\b0[xX][0-9a-fA-F](?:['_]?[0-9a-fA-F])*\\b"
    },
    {
     "name": "constant.numeric.integer.binary.z80asm",
     "match": "\\b0[bB][01](?:['_]?[01])*\\b"
    },
    {
     "name": "constant.numeric.integer.octal.z80asm",
     "match": "\\b0[qQ][0-7](?:['_]?[0-7])*\\b"
    },
    {
     "name": "variable.parameter.label.temporary.z80asm",
     "match": "\\b\\d+(?:_[bBfF]|[fF])\\b"
    },
    {
     "name": "constant.numeric.integer.hexadecimal.z80asm",
     "match": "\\b\\d(?:['_]?[0-9a-fA-F])*[hH]\\b"
    },
    {
     "name": "constant.numeric.integer.binary.z80asm",
     "match": "\\b[01](?:['_]?[01])*[bB]\\b"
    },
    {
     "name": "variable.parameter.label.temporary.z80asm",
     "match": "\\b\\d+[bB]\\b"
    },
    {
     "name": "constant.numeric.integer.octal.z80asm",
     "match": "\\b[0-7](?:['_]?[0-7])*[qQoO]\\b"
    },
    {
     "name": "constant.numeric.integer.binary.z80asm",
     "match": "%[01](?:['_]?[01])*\\b"
    },
    {
     "name": "constant.numeric.integer.decimal.z80asm",
     "match": "\\b\\d(?:['_]?\\d)*(?:\\.\\d+)?[dD]?\\b"
    }
   ]
  },
  "includes": {
   "patterns": [
    {
     "match": "(?i:(?<=[\\s:])(include)\\b)(?:\\s*(<[^>\\n]*>))?",
     "captures": {
      "1": {
       "name": "keyword.control.z80asm"
      },
      "2": {
       "name": "string.quoted.other.z80asm"
      }
     }
    }
   ]
  },
  "labels": {
   "patterns": [
    {
     "match": "(?<!\\w)[.@]?[A-Za-z_][\\w.!?#@]*",
     "name": "variable.parameter.label.z80asm"
    }
   ]
  },
  "label-definition": {
   "match": "^(?:\\s*>)?([@!]?\\.?[A-Za-z_][\\w.!?#@]*|\\d+)(\\+[\\d*])?(?:(:)|(?=\\s|$))",
   "captures": {
    "1": {
     "name": "entity.name.function.z80asm"
    },
    "2": {
     "name": "entity.name.function.z80asm"
    }
   }
  },
  "end-of-source": {
   "begin": "(?i:^(?:(?:\\s*>)?([@!]?\\.?[A-Za-z_][\\w.!?#@]*|\\d+)(\\+[\\d*])?:?)?\\s+\\.?(end)\\b)",
   "beginCaptures": {
    "1": {
     "name": "entity.name.function.z80asm"
    },
    "2": {
     "name": "entity.name.function.z80asm"
    },
    "3": {
     "name": "keyword.control.z80asm"
    }
   },
   "end": "(?!)",
   "patterns": [
    {
     "name": "comment.block.ignored.z80asm",
     "match": "^.+"
    },
    {
     "include": "#comments"
    },
    {
     "include": "#numbers"
    },
    {
     "include": "#labels"
    }
   ]
  },
  "directive": {
   "patterns": [
    {
     "match": "(?i:^(?:(?:\\s*>)?([@!]?\\.?[A-Za-z_][\\w.!?#@]*|\\d+)(\\+[\\d*])?:?)?\\s+((?:\\.(?:\\d+|\\([^)\\n]*\\))\\s+)*)(\\.?(?:(?:define|defarray)\\+(?=\\s)|(?:relocate_start|relocate_table|setbreakpoint|relocate_end|includelua|labelslist|saveamsdos|savecpcsna|cspectmap|defdevice|endmodule|endrepeat|endstruct|exitmacro|ifnexists|memorymap|shellexec|defarray|emptytap|emptytrd|encoding|endmacro|endwhile|ifexists|save3dos|textarea|undefine|defpage|dephase|display|ifnused|savebin|savecdt|savecpr|savedev|savehex|savehob|savenex|savesna|savetap|savetrd|unphase|winexec|abytec|abytez|ascmap|assert|binary|bplist|define|device|elseif|endlua|endmap|endmod|export|hexend|hexout|ifdifi|ifidni|ifndef|ifnnum|ifnstr|ifused|incbin|inchob|inctrd|insert|module|outend|output|repeat|rotate|sldopt|struct|tapend|tapout|update|abyte|align|block|dword|endif|error|field|ifdef|ifdif|ifidn|ifini|ifnid|ifnum|ifstr|macro|phase|setbp|while|byte|code|defb|defd|defl|defm|defp|defs|defw|disp|edup|else|endm|endr|ends|endt|endw|fpos|ifid|ifin|ifnb|page|rept|size|slot|text|word|d24|dup|end|ent|equ|ifb|ifn|map|mmu|opt|org|db|dc|dd|dm|dp|ds|dt|dw|dz|if)\\b)|\\.(?:defg|defh|dg|dh|hex|include|lua)\\b))",
     "captures": {
      "1": {
       "name": "entity.name.function.z80asm"
      },
      "2": {
       "name": "entity.name.function.z80asm"
      },
      "3": {
       "name": "keyword.control.repeat.z80asm"
      },
      "4": {
       "name": "keyword.control.z80asm"
      }
     }
    },
    {
     "match": "(?i:(?<=:)\\s*((?:\\.(?:\\d+|\\([^)\\n]*\\))\\s+)*)(\\.?(?:(?:define|defarray)\\+(?=\\s)|(?:relocate_start|relocate_table|setbreakpoint|relocate_end|includelua|labelslist|saveamsdos|savecpcsna|cspectmap|defdevice|endmodule|endrepeat|endstruct|exitmacro|ifnexists|memorymap|shellexec|defarray|emptytap|emptytrd|encoding|endmacro|endwhile|ifexists|save3dos|textarea|undefine|defpage|dephase|display|ifnused|savebin|savecdt|savecpr|savedev|savehex|savehob|savenex|savesna|savetap|savetrd|unphase|winexec|abytec|abytez|ascmap|assert|binary|bplist|define|device|elseif|endlua|endmap|endmod|export|hexend|hexout|ifdifi|ifidni|ifndef|ifnnum|ifnstr|ifused|incbin|inchob|inctrd|insert|module|outend|output|repeat|rotate|sldopt|struct|tapend|tapout|update|abyte|align|block|dword|endif|error|field|ifdef|ifdif|ifidn|ifini|ifnid|ifnum|ifstr|macro|phase|setbp|while|byte|code|defb|defd|defl|defm|defp|defs|defw|disp|edup|else|endm|endr|ends|endt|endw|fpos|ifid|ifin|ifnb|page|rept|size|slot|text|word|d24|dup|end|ent|equ|ifb|ifn|map|mmu|opt|org|db|dc|dd|dm|dp|ds|dt|dw|dz|if)\\b)|\\.(?:defg|defh|dg|dh|hex|include|lua)\\b))",
     "captures": {
      "1": {
       "name": "keyword.control.repeat.z80asm"
      },
      "2": {
       "name": "keyword.control.z80asm"
      }
     }
    },
    {
     "match": "^(?:(?:\\s*>)?([@!]?\\.?[A-Za-z_][\\w.!?#@]*|\\d+)(\\+[\\d*])?:?)?\\s+(\\[[^\\]\\n]*\\])(?=\\s)",
     "captures": {
      "1": {
       "name": "entity.name.function.z80asm"
      },
      "2": {
       "name": "entity.name.function.z80asm"
      },
      "3": {
       "name": "keyword.control.repeat.z80asm"
      }
     }
    }
   ]
  },
  "line-directive": {
   "match": "^\\s*(#\\s*line)\\b",
   "captures": {
    "1": {
     "name": "keyword.control.z80asm"
    }
   }
  }
 },
 "scopeName": "source.z80asm"
}
